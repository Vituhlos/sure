<%= link_to t(".back"), rules_path %>

<%= render DS::Dialog.new do |dialog| %>
  <%
    resource_name = t("rules.resources.#{@rule.resource_type}", count: 2)
    title = if @rule.name.present?
              t(".title_with_name", name: @rule.name, resource: resource_name)
            else
              t(".title", resource: resource_name)
            end
  %>
  <% dialog.with_header(title: title) %>

  <% dialog.with_body do %>
    <%= render "rules/form", rule: @rule %>
  <% end %>
<% end %>
